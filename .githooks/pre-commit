#!/bin/sh
# Refuse to commit somebody's CV, profile, or anything generated from them.
#
# .gitignore already lists these, but .gitignore is advice and `git add -f` is
# one keystroke. This is the layer that says no. CI checks the tracked file
# list as well, for the fork where nobody ran the git config line.
#
# Turn it on with:  git config core.hooksPath .githooks

# Anchored at the repo root: `plugins/jobhunt/` is the shipped plugin, and an
# unanchored 'jobhunt/' would refuse every commit that touches it.
private=$(git diff --cached --name-only \
          | grep -E '^(jobhunt/|cv/|runs/|profile\.yaml$)' \
          | grep -vE '^cv/README\.md$|^runs/\.gitkeep$')

if [ -n "$private" ]; then
  echo "refusing to commit files that are yours, not the repo's:"
  printf '  %s\n' $private
  echo
  echo "If you really mean it: git commit --no-verify"
  exit 1
fi
